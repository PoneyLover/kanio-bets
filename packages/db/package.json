{
  "name": "@kanio/db",
  "version": "1.0.0",
  "private": true,
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
