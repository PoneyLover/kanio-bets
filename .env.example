# =============================================================================
# KANIO - Variables d'environnement (exemple)
# Copier ce fichier en .env dans packages/db/, apps/api/ et apps/web/
# (voir README.md section "Configuration" pour le detail par appli)
# Ne JAMAIS committer de vrai fichier .env
# =============================================================================

# --- Base de donnees (packages/db, apps/api) ---
# En local (docker-compose) : une seule URL suffit.
DATABASE_URL="postgresql://user:password@localhost:5432/kanio?schema=public"
# Avec Neon (ou tout Postgres derriere PgBouncer en mode "transaction") :
# - DATABASE_URL doit pointer vers l'endpoint POOLER avec pgbouncer=true
# - DIRECT_URL (packages/db uniquement, pour Prisma Migrate) pointe vers l'endpoint DIRECT (sans "-pooler")
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# --- Authentification (apps/api) ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Economie virtuelle KANIO (apps/api) ---
INITIAL_KANIO_BALANCE="1000"

# --- Compte administrateur de developpement (packages/db seed, apps/api) ---
ADMIN_EMAIL="admin@kanio.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_USERNAME="admin"

# --- Serveur API (apps/api) ---
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
