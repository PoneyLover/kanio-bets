DATABASE_URL="postgresql://kanio:kanio@localhost:5432/kanio?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

INITIAL_KANIO_BALANCE="1000"

ADMIN_EMAIL="admin@kanio.local"
